.DS_Store
*.xccheckout
*.xcscmblueprint
xcuserdata
WXYC/DerivedData
DerivedData
WXYC/WXYC.xcodeproj/xcshareddata/*
WXYC.xcodeproj/project.xcworkspace/xcshareddata/
*Secrets.swift
**/.build/*

# Swift Package Manager build artifacts
build/
**/build/
.swiftpm/

# Xcode build logs
Build*.txt

# Test result bundles emitted by scripts/test-affected.sh and CI
*.xcresult

# Merge/rebase conflict leftovers. Untracked and unignored, one of these inside
# a package's Sources/ is picked up by scripts/test-affected.sh (which reads
# `git ls-files --others --exclude-standard`) and permanently marks that
# package affected, and SwiftPM treats it as an unhandled source file.
*.orig
*.rej

# Local gitignore files in packages
WXYC/Shared/*/.gitignore

# VS Code configuration
.vscode/

# Third-party audio streaming library
AudioStreaming/
.cursor

# Affinity Designer files
*.afdesign

# Party Horn assets (separate project)
WXYC/Shared/Party Horn/assets/
worklog/

# Sentry CLI config (contains auth token)
.sentryclirc

# Scratch clone used by scripts/regenerate-api-types.sh / verify-api-types.sh
# (already covered by **/.build/* above; called out explicitly for clarity)
.build/wxyc-shared-codegen/

# Catalogs and reports written by the code-audit tool. Machine-generated and
# rebuilt on demand; the tool appends this entry itself, so ignoring it here
# keeps `code-audit` from dirtying every tree it runs in.
.audit/
