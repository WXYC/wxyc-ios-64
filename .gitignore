.DS_Store
*.xccheckout
*.xcscmblueprint
xcuserdata
WXYC/DerivedData
DerivedData
WXYC/WXYC.xcodeproj/xcshareddata/*
WXYC.xcodeproj/project.xcworkspace/xcshareddata/
*Secrets.swift
# Name collision, not an exemption: the rule above is the only thing keeping the
# real Shared/Secrets/.../Secrets.swift (generated with live values by the
# pre-build phase) out of the repo, so it stays. The directory below is a
# different animal — machine-owned OpenAPI models, field declarations and doc
# comments with no values, regenerated wholesale and guarded by
# verify-api-types.sh, which fails if any of them is missing from the commit.
# Scoped by glob rather than by exact filename so the next generated model that
# happens to end in Secrets.swift isn't silently dropped from git add the way
# AppSecrets.swift was — that failure is invisible locally (verify diffs the
# filesystem, not the index) and only surfaces as drift on a clean CI checkout.
!Shared/WXYCAPIModels/Sources/WXYCAPIModels/Models/*Secrets.swift
**/.build/*

# Swift Package Manager build artifacts
build/
**/build/
.swiftpm/

# Xcode build logs
Build*.txt

# Test result bundles emitted by scripts/test-affected.sh and CI
*.xcresult

# Merge/rebase conflict leftovers. Untracked and unignored, one of these inside
# a package's Sources/ is picked up by scripts/test-affected.sh (which reads
# `git ls-files --others --exclude-standard`) and permanently marks that
# package affected, and SwiftPM treats it as an unhandled source file.
*.orig
*.rej

# Local gitignore files in packages
WXYC/Shared/*/.gitignore

# VS Code configuration
.vscode/

# Third-party audio streaming library
AudioStreaming/
.cursor

# Affinity Designer files
*.afdesign

# Party Horn assets (separate project)
WXYC/Shared/Party Horn/assets/
worklog/

# Sentry CLI config (contains auth token)
.sentryclirc

# Tools ci_scripts/install-sentry-cli.sh vendors into the checkout (sentry-cli).
# Binaries, per-machine, reinstalled on demand.
.ci-tools/

# Scratch clone used by scripts/regenerate-api-types.sh / verify-api-types.sh
# (already covered by **/.build/* above; called out explicitly for clarity)
.build/wxyc-shared-codegen/

# Catalogs and reports written by the code-audit tool. Machine-generated and
# rebuilt on demand; the tool appends this entry itself, so ignoring it here
# keeps `code-audit` from dirtying every tree it runs in.
.audit/

# Git worktrees. The convention is one checkout per line of development under
# .worktrees/; they are working state, never content to commit.
.worktrees/
